{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "description": "Configure a Debug build with GCC.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "description": "Configure a Release build with GCC.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "description": "Configure a Debug build with Clang.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "description": "Configure a Release build with Clang.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "targets": [
        "all"
      ]
    },
    {
      "name": "gcc-debug-tests",
      "configurePreset": "gcc-debug",
      "targets": [
        "nn-training-tests"
      ]
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "targets": [
        "all"
      ]
    },
    { 
      "name": "gcc-release-tests",
      "configurePreset": "gcc-release",
      "targets": [
        "nn-training-tests"
      ]
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "targets": [
        "all"
      ]
    },
    {
      "name": "clang-debug-tests",
      "configurePreset": "clang-debug",
      "targets": [
        "nn-training-tests"
      ]
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "targets": [
        "all"
      ]
    },
    {
      "name": "clang-release-tests",
      "configurePreset": "clang-release",
      "targets": [
        "nn-training-tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
